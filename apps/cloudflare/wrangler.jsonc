{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostwriter",
  "account_id": "ecc90d64c0a91444c19af318526d2190",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "AI_API_URL": "https://api.openai.com/v1/chat/completions",
    "META_GRAPH_BASE": "https://graph.facebook.com",
    "META_GRAPH_VERSION": "v23.0",
    "PUBLISHING_ENABLED": "false",
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghostwriter",
      "database_id": "a8f36e7e-ea90-4413-91da-9b3219551098",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ghostwriter-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "d8f21913223f4e7a8cd8a199a5a28b5e",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
